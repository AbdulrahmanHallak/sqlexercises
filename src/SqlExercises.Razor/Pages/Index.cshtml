@page
@model IndexModel
@{
    ViewData["Title"] = "Schemas";
}
<h2>Schemas</h2>

<a asp-page="./Schemas/Create" class="btn btn-success mb-3">Create New Schema</a>

<ul class="list-group">
    @foreach (var schema in Model.Schemas)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
                <a asp-page="./Schemas/View" asp-route-schema="@schema.ShortName">@schema.SchemaName</a>
            </span>
        </li>
    }
</ul>
>