@page "/schemas/{schema:alpha}/Exercises"
@model IndexModel
@{
    ViewData["Title"] = $"Exercises for {Model.Category}";
}
<h2>Exercises for @Model.Schema</h2>
<a asp-page="Create" asp-route-schema="@Model.Schema" class="btn btn-success mb-3">Create New Exercise</a>
<ul class="list-group">
    @foreach (var ex in Model.Exercises)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
                <a asp-page="./Exercise" asp-route-schema="@Model.Schema" asp-route-category="@Model.Category"
                    asp-route-id="@ex.Id">
                    @ex.Title
                </a>

            </span>
            <span>
                <a asp-page="./Edit" asp-route-category="@Model.Category" asp-route-id="@ex.Id"
                    asp-route-schema="@Model.Schema" class="btn btn-sm btn-primary me-1">Edit</a>

            </span>

        </li>
    }
</ul>