@page "/schemas/{schema:alpha}/edit"
@model EditModel
@{
    ViewData["Title"] = $"Edit Schema - {Model.Schema}";
}

<div class="row">
    <div class="col-md-8">
        <h2>Edit Schema: @Model.Schema</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Combined Form -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Update Schema</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="EditSchema.Name" class="form-label">Schema Name</label>
                        <input asp-for="EditSchema.Name" class="form-control" maxlength="20" />
                        <span asp-validation-for="EditSchema.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditSchema.Sql" class="form-label">SQL Commands (Optional)</label>
                        <textarea asp-for="EditSchema.Sql" class="form-control" rows="8"
                            placeholder="Enter your SQL commands here..."></textarea>
                        <span asp-validation-for="EditSchema.Sql" class="text-danger"></span>
                        <div class="form-text">
                            <strong>Note:</strong> Only CREATE, UPDATE, DELETE, and DDL statements are supported.
                            SELECT queries and statements that return values are not supported in this editor.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Update Schema</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- SQL Limitations Info -->
        <div class="card">
            <div class="card-header">
                <h6 class="card-title mb-0">SQL Execution Guidelines</h6>
            </div>
            <div class="card-body">
                <h6>Supported Operations:</h6>
                <ul class="list-unstyled">
                    <li>✅ CREATE TABLE</li>
                    <li>✅ ALTER TABLE</li>
                    <li>✅ DROP TABLE</li>
                    <li>✅ INSERT</li>
                    <li>✅ UPDATE</li>
                    <li>✅ DELETE</li>
                    <li>✅ CREATE INDEX</li>
                    <li>✅ CREATE SEQUENCE</li>
                </ul>

                <h6 class="mt-3">Not Supported:</h6>
                <ul class="list-unstyled">
                    <li>❌ SELECT queries</li>
                    <li>❌ Functions returning values</li>
                    <li>❌ Stored procedures with output</li>
                    <li>❌ Any statement that returns data</li>
                </ul>

                <div class="alert alert-info mt-3">
                    <small>
                        <strong>Tip:</strong> Use the Playground for SELECT queries and data exploration.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <a asp-page="./Index" class="btn btn-secondary">Back to Schemas</a>
        <a asp-page="./Playground" asp-route-schema="@Model.Schema" class="btn btn-info">Open Playground</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
